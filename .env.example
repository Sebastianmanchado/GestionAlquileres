# =====================================================================
# Variables de entorno — copiar a .env en la raíz del repo y completar.
# El .env está gitignoreado: NUNCA commitear credenciales reales.
# Misma instancia Somee que MatrizPonderada (GIA_DB_PoC).
# =====================================================================

# --------------------------------------------------------------------
# SQL Server en somee.com (connection string .NET original en MatrizPonderada/.env.example)
# --------------------------------------------------------------------
SGA_DB_URL=jdbc:sqlserver://GIA_DB_PoC.mssql.somee.com:1433;databaseName=GIA_DB_PoC;encrypt=true;trustServerCertificate=true;packetSize=4096
SGA_DB_USER=jppirra_SQLLogin_1
SGA_DB_PASSWORD=

# Perfil cloud para probar contra Somee desde local (opcional):
# SPRING_PROFILES_ACTIVE=cloud

# CORS (producción / previews Vercel)
# SGA_CORS_ORIGINS=https://*.vercel.app

# WebService SOAP de asientos. SISALQ es el usuario de conexión, no un dato del asiento.
# SGA_SAP_URL=
# SGA_SAP_USER=SISALQ
# SGA_SAP_PASSWORD=
# SGA_SAP_SOAP_ACTION=

# --------------------------------------------------------------------
# Frontend (Vercel) — ver frontend/.env.production
# Modo A (proxy vercel.json): dejar VITE_API_URL vacío
# Modo B (directo): VITE_API_URL=https://gestionalquileres-3.onrender.com/api
# --------------------------------------------------------------------
